# 로컬 웹 시연 설정. cp .env.example .env 후 수정하세요.
# npm run operator / npm run serve가 .env를 읽습니다.
# 외부에서 주입된 환경변수가 .env보다 우선합니다.

# 웹 서버에만 필수: 24자 이상의 임의 접속 코드. 빈 값이면 시작을 거부합니다.
# 생성 예: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
DEMO_ACCESS_CODE=

# 로컬 접속 주소. PORT를 변경하면 PUBLIC_ORIGIN도 함께 변경하세요.
HOST=127.0.0.1
PORT=8080
PUBLIC_ORIGIN=http://127.0.0.1:8080

# 두 경로는 반드시 OPERATOR_DIR = DATA_DIR/operator로 맞추세요.
# 기존 CLI의 기본 저장 경로를 그대로 사용합니다.
DATA_DIR=.local-demo
OPERATOR_DIR=.local-demo/operator

# 현재 Aomi 연결에는 AOMI_API_KEY / OPENAI_API_KEY를 입력하지 않습니다.
# Aomi 주소 https://chat.aomi.dev, 체인 Base Sepolia(84532)는 코드에 고정되어 있습니다.
# operator init이 만든 전용 지갑으로 aomi-submit이 SIWE 로그인합니다.
# 인증은 OPERATOR_DIR/aomi-session, 키는 OPERATOR_DIR/secrets.json에 저장됩니다.
# PRIVATE_KEY / AOMI_STATE_DIR / AOMI_ACCOUNT_BEARER는 로그인 자식 프로세스에서
# 코드가 설정하므로 이 파일에 넣지 마세요. MetaMask 개인키도 필요하지 않습니다.
